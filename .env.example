# Connection string de um banco Postgres. Pra desenvolvimento local, crie um
# banco gratuito em https://neon.tech (ou qualquer outro Postgres) e cole a
# connection string aqui.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Opcional: token do GitHub usado como fallback quando nenhum token estiver
# salvo na tela de Configuracoes do app. Necessario para repositorios
# privados e para evitar o limite de 60 requisicoes/hora sem autenticacao.
# Crie em https://github.com/settings/tokens?type=beta (permissao de leitura em Contents).
GITHUB_TOKEN=
